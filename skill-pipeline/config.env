# Skill Pipeline Configuration
# Proxy settings (leave empty for auto-detection)
PROXY_HOST=127.0.0.1
PROXY_PORT=11721

# Mirror settings
GITHUB_MIRRORS=https://ghproxy.com,https://gitclone.com
NPM_MIRROR=https://registry.npmmirror.com

# Concurrency
MAX_CONCURRENT=5

# Retry settings
MAX_RETRIES=3
INITIAL_DELAY_SECONDS=2
BACKOFF_MULTIPLIER=2

# Timeouts (seconds)
GITHUB_API_TIMEOUT=30
GIT_CLONE_TIMEOUT=120
NPM_INSTALL_TIMEOUT=60

# Vetting strictness (permissive|standard|strict)
VETTING_MODE=standard
